---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="RDFS-LLM-Bench: A Benchmark for Evaluating RDF Schema Inference in LLMs — ISWC 2026"
  description="The 25th International Semantic Web Conference (ISWC 2026), Resource Track. 準備中。"
  showNav={false}
>
  <div class="mx-auto w-full max-w-2xl px-6 py-16 sm:px-8 lg:py-24">
    <nav class="mb-12">
      <a href="/" class="inline-flex items-center gap-1.5 text-sm text-ink-faint transition-colors hover:text-ink dark:text-[#86868b] dark:hover:text-white">
        ← Taichi Hosokawa
      </a>
    </nav>

    <header>
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-ink-faint dark:text-[#86868b]">Resource Track</p>
      <h1 class="mt-3 text-2xl font-semibold leading-snug tracking-tight text-ink sm:text-3xl dark:text-[#f5f5f7]">
        RDFS-LLM-Bench: A Benchmark for Evaluating RDF Schema Inference in LLMs
      </h1>
      <p class="mt-4 font-mono text-xs text-ink-faint dark:text-[#86868b]">
        The 25th International Semantic Web Conference (ISWC 2026), Resource Track
      </p>
    </header>

    <main class="mt-16 space-y-14">
      <section>
        <p class="leading-relaxed text-ink-soft dark:text-[#a1a1a6]">このページは準備中です。</p>
        <div class="mt-6">
          <a
            href="/rdfs-llm-bench/ja"
            class="group -mx-3 flex items-center justify-between gap-4 rounded-xl px-3 py-4 transition-colors hover:bg-black/[0.025] dark:hover:bg-white/[0.04]"
          >
            <span>
              <span class="block text-sm font-medium text-ink-faint dark:text-[#86868b]">Research / Benchmark</span>
              <span class="mt-1 block font-medium leading-snug text-ink dark:text-[#f5f5f7]">RDFS-LLM-Bench</span>
            </span>
            <span class="shrink-0 text-ink-faint transition-all duration-300 group-hover:translate-x-0.5 group-hover:text-ink dark:text-[#86868b] dark:group-hover:text-white">→</span>
          </a>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
